# dependencies (run `npm install` / start.bat to get them)
node_modules/

# WhatsApp login data and caches — never commit these (the app keeps them in %USERPROFILE%WhatsAppChatExporter,
# these entries are just a safety net)
.wwebjs_auth/
.wwebjs_cache/
session-*/
media-cache/
browser-cache/
people-cache.json

# exports and local tool settings
*.xlsx
*.zip
*.log
.claude/
.vscode/
.DS_Store
Thumbs.db

# Google Sheets bot key: secret, kept in %USERPROFILE%\WhatsAppChatExporter (never commit it)
google-service-account*.json
sheet-sync.json
keep.json
# any other JSON dropped in the project folder (e.g. a downloaded key) stays out of git
/*.json
!/package.json
!/package-lock.json
